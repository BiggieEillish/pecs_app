# Normalize line endings: store LF in the repo, check out native on each OS.
* text=auto eol=lf

# Windows-only scripts must stay CRLF
*.bat   text eol=crlf

# The Gradle wrapper script must stay LF so it runs on macOS/Linux/CI
gradlew text eol=lf

# Treat these as binary (never normalize / diff)
*.jar      binary
*.png      binary
*.jpg      binary
*.webp     binary
*.pdf      binary
*.apk      binary
*.aab      binary
*.keystore binary
*.jks      binary
